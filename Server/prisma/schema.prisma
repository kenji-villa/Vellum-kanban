generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum CardStatus {
  OPEN
  SUBMITTED
  DONE
}

enum BoardRole {
  EDITOR
  VIEWER
}

model CardActivity {
  id        String   @id @default(cuid())
  cardId    String
  boardId   String
  actorId   String?
  type      String
  body      String?
  meta      Json?
  createdAt DateTime @default(now())
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  actor     User?    @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([cardId, createdAt])
  @@index([boardId, createdAt])
  @@map("card_activities")
}

model BoardMember {
  id        String   @id @default(cuid())
  boardId   String
  userId    String
  createdAt DateTime @default(now())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role BoardRole @default(EDITOR)

  @@unique([boardId, userId])
  @@index([userId])
  @@map("board_members")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bannerUrl String?
  bio       String?
  title     String?
  avatarUrl String?
  boards    Board[]
  department String?
  phone      String?
  country    String?
  city       String?
  languages  String[] @default([])
  skills     String[] @default([])
  links      Json?
  invitesSent        Invitation[]   @relation("InvitesSent")
  invitesReceived    Invitation[]   @relation("InvitesReceived")
  notifications      Notification[] @relation("NotificationOwner")
  notificationsActed Notification[] @relation("NotificationActor")
  boardMemberships BoardMember[]
  assignedCards    Card[] @relation("CardAssignee")
  cardsAssignedByMe Card[] @relation("CardAssigner")
  activities CardActivity[] @relation("ActivityActor")

  @@map("users")
}

model Invitation {
  id            String           @id @default(cuid())
  senderId      String
  receiverId    String
  status        InvitationStatus @default(PENDING)
  message       String?
  createdAt     DateTime         @default(now())
  respondedAt   DateTime?
  sender        User             @relation("InvitesSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver      User             @relation("InvitesReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@map("invitations")
}


model Notification {
  id           String      @id @default(cuid())
  userId       String
  type         String
  actorId      String?
  invitationId String?
  readAt       DateTime?
  createdAt    DateTime    @default(now())
  user         User        @relation("NotificationOwner", fields: [userId], references: [id], onDelete: Cascade)
  actor        User?       @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  invitation   Invitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  boardId String?
  cardId  String?
  note String?
  board   Board? @relation(fields: [boardId], references: [id], onDelete: Cascade)
  card    Card?  @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

model Board {
  id        String   @id @default(cuid())
  title     String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lists     List[]
  labels BoardLabel[]
  members       BoardMember[]
  notifications Notification[]
  activities CardActivity[]

  @@map("boards")
}

model List {
  id        String   @id @default(cuid())
  title     String
  position  Int      @default(0)
  boardId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cards     Card[]
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@map("lists")
}

model Card {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  priority    String    @default("medium")
  dueDate     DateTime?
  labels      String[]  @default([])
  assignee    String    @default("")
  comments    Int       @default(0)
  position    Int       @default(0)
  listId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  list        List      @relation(fields: [listId], references: [id], onDelete: Cascade)
  assigneeId    String?
  assigneeUser  User?  @relation("CardAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  notifications Notification[]
  status       CardStatus @default(OPEN)
  assignedById String?
  assignedBy   User?      @relation("CardAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  submittedAt  DateTime?
  completedAt  DateTime?
  activities CardActivity[]

  @@map("cards")
}

model BoardLabel {
  id        String   @id @default(cuid())
  boardId   String
  name      String
  color     String
  createdAt DateTime @default(now())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([boardId, name])
  @@map("board_labels")
}
